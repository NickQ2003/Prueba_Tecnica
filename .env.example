COMPOSE_PROJECT_NAME=arrenda-demo
POSTGRES_DB=policies
POSTGRES_USER=policies
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql+psycopg://policies:local-only-change-me@db:5432/policies
RABBITMQ_PASSWORD=local-only-change-me
RABBITMQ_URL=amqp://policies:local-only-change-me@rabbitmq:5672//
CORE_BASE_URL=http://core-mock:8081
CORE_TIMEOUT_SECONDS=2
API_READ_TOKEN=demo-read-token
API_OPERATOR_TOKEN=demo-operator-token
API_REVIEWER_TOKEN=demo-reviewer-token
DEMO_CONTROLS_ENABLED=true
LOG_LEVEL=INFO
RENEWAL_DAYS_AHEAD=30
MAX_CORE_CONCURRENCY=2
GATEWAY_PORT=8080
